# Local development only. Copy to .env; never commit real credentials.
POSTGRES_DB=decor
POSTGRES_USER=decor
POSTGRES_PASSWORD=decor_local
# Keep this URL in sync with the values above; URL-encode reserved characters.
DATABASE_URL=postgresql://decor:decor_local@localhost:5437/decor
FRONTEND_PORT=5007
BACKEND_PORT=9007

# Browser-reachable backend address, including /api exactly once.
NEXT_PUBLIC_API_URL=http://localhost:9007/api
CORS_ORIGINS=http://localhost:5007
POSTGRES_PORT=5437

# Backend-only runtime and Docker connection. Never expose these to the frontend.
NODE_ENV=development
DOCKER_DATABASE_URL=postgresql://decor:decor_local@postgres:5432/decor
# Optional one-time trusted administrator bootstrap input (server-only).
# Set confirmation to true only when intentionally provisioning this account.
SEED_DEMO=false
SEED_ADMIN_NAME=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_CONFIRM_VERIFIED=false

# Email activation and JWT authentication (server-only).
STORE_NAME=Home & Lifestyle
FRONTEND_URL=http://localhost:5007
JWT_SECRET=
JWT_ISSUER=home-lifestyle
JWT_AUDIENCE=home-lifestyle-api
JWT_ACCESS_SECONDS=900
REFRESH_DAYS=7
ACTIVATION_HOURS=24
RESEND_COOLDOWN_SECONDS=60
RESEND_HOURLY_LIMIT=5
LOGIN_ACCOUNT_LIMIT=10
AUTH_IP_LIMIT=60
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# Category images (backend only). Leave blank to run without upload capability.
# Configure these values in the root .env for local development and deployment secrets for production.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=home-lifestyle/categories
# Maximum accepted category image size in bytes (5 MiB).
# Shared category, product, and profile-photo upload limit (5 MB default).
CATEGORY_IMAGE_MAX_BYTES=5242880
