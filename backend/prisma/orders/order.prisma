model Order {
  id                    String             @id @default(uuid())
  orderNumber           String             @unique
  checkoutKey           String             @unique
  customerId            String?
  email                 String
  phone                 String?
  currency              String             @default("INR")
  // Required immutable purchase-time address object, independent of CustomerAddress.
  deliveryAddress       Json
  status                String
  subtotalPaise         Int
  discountPaise         Int
  shippingPaise         Int
  taxPaise              Int?
  giftFeePaise          Int
  totalPaise            Int
  giftOptions           Json?
  shippingQuoteSnapshot Json?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  customer              Customer?          @relation(fields: [customerId], references: [id], onDelete: SetNull)
  lines                 OrderLine[]
  payments              PaymentAttempt[]
  shipments             Shipment[]
  adjustments           OrderAdjustment[]
  couponRedemptions     CouponRedemption[]

  @@index([customerId, createdAt])
  @@index([status, createdAt])
}

model OrderLine {
  productIdSnapshot String
  variantIdSnapshot String
  discountsSnapshot Json
  id                String            @id @default(uuid())
  orderId           String
  variantId         String?
  productName       String
  variantName       String
  sku               String
  quantity          Int
  unitPricePaise    Int
  discountPaise     Int
  taxPaise          Int?
  totalPaise        Int
  // Includes selected option labels/values, bundle composition and customisation definitions/values.
  optionsSnapshot   Json
  giftOptions       Json?
  order             Order             @relation(fields: [orderId], references: [id], onDelete: Restrict)
  variant           ProductVariant?   @relation(fields: [variantId], references: [id], onDelete: SetNull)
  shipmentLines     ShipmentLine[]
  adjustments       OrderAdjustment[]

  @@unique([id, orderId])
  @@index([orderId])
  @@index([variantId])
}

// A cancellation or return request targets a purchased line and quantity.
model OrderAdjustment {
  id          String         @id @default(uuid())
  orderId     String
  orderLineId String
  kind        AdjustmentKind
  quantity    Int
  status      String
  reason      String?
  evidence    Json?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  order       Order          @relation(fields: [orderId], references: [id], onDelete: Restrict)
  line        OrderLine      @relation(fields: [orderLineId, orderId], references: [id, orderId], onDelete: Restrict)

  @@index([orderLineId, orderId])
  @@index([status, createdAt])
}

enum AdjustmentKind {
  CANCELLATION
  RETURN
}
