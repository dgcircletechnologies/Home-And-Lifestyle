model Coupon {
  id                   String             @id @default(uuid())
  name                 String             @default("")
  lifecycle            String             @default("DRAFT")
  scope                String             @default("CART")
  code                 String             @unique
  enabled              Boolean            @default(false)
  kind                 DiscountKind
  amountPaise          Int?
  percentBasisPoints   Int?
  minimumCartPaise     Int?
  maximumDiscountPaise Int?
  startsAt             DateTime?
  expiresAt            DateTime?
  usageLimit           Int?
  perCustomerLimit     Int?
  // Null means policy undecided, not permission to stack.
  stackingGroup        String?
  allowStacking        Boolean?
  products             CouponProduct[]
  categories           CouponCategory[]
  collections          CouponCollection[]
  redemptions          CouponRedemption[]

  @@index([lifecycle, enabled, startsAt, expiresAt])
}

enum DiscountKind {
  FIXED
  PERCENTAGE
}

model CouponProduct {
  couponId  String
  productId String
  coupon    Coupon  @relation(fields: [couponId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@id([couponId, productId])
  @@index([productId])
}

model CouponCategory {
  couponId   String
  categoryId String
  coupon     Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@id([couponId, categoryId])
  @@index([categoryId])
}

model CouponCollection {
  couponId     String
  collectionId String
  coupon       Coupon     @relation(fields: [couponId], references: [id], onDelete: Cascade)
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Restrict)

  @@id([couponId, collectionId])
  @@index([collectionId])
}

model CouponRedemption {
  id            String   @id @default(uuid())
  couponId      String?
  customerId    String?
  orderId       String
  codeSnapshot  String
  discountPaise Int
  rulesSnapshot Json
  createdAt     DateTime @default(now())
  coupon        Coupon?  @relation(fields: [couponId], references: [id], onDelete: SetNull)
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@unique([orderId, codeSnapshot])
  @@index([couponId])
  @@index([couponId, customerId])
}

// Timed product/category sale definitions. Resolution and stacking are application policy.
model Promotion {
  id                 String       @id @default(uuid())
  name               String
  lifecycle          String       @default("DRAFT")
  enabled            Boolean      @default(false)
  productId          String?
  categoryId         String?
  kind               DiscountKind
  amountPaise        Int?
  percentBasisPoints Int?
  startsAt           DateTime?
  endsAt             DateTime?
  product            Product?     @relation(fields: [productId], references: [id], onDelete: Restrict)
  category           Category?    @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@index([productId, enabled])
  @@index([categoryId, enabled])
  @@index([lifecycle, enabled, startsAt, endsAt])
}
