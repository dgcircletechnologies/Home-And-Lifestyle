    "@nestjs/core": "12.5.0",
    "@nestjs/platform-express": "12.5.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "@prisma/client": "7.10.1",
    "@prisma/adapter-pg": "7.10.1",
    "pg": "^8.16.3",
    "dotenv": "^17.2.3"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@nestjs/cli": "11.0.24",
    "@types/node": "^24.0.0",
    "eslint": "9.39.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2",
    "prisma": "7.10.1",
    "@types/pg": "^8.15.6"
  },
  "engines": {
    "node": ">=24.13.0 <25"
