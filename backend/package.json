{
  "name": "home-lifestyle-backend",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "npm run prisma:generate && nest start --watch",
    "build": "npm run prisma:generate && nest build && cp -R generated dist/generated",
    "start": "node dist/src/main.js",
    "lint": "eslint .",
    "typecheck": "npm run prisma:generate && tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:format": "prisma format",
    "prisma:test": "node prisma/tests/business-schema.test.mjs",
    "admin:create": "node dist/src/admin-bootstrap.js",
    "seed:admin": "npm run build && node dist/src/admin-bootstrap.js",
    "seed:admin:prod": "node dist/src/seed-admin-prod.js",
    "seed:demo": "npm run build && node dist/src/dev-seed.js",
    "seed:dashboard": "npm run build && node dist/src/seed-admin-dashboard.js",
    "test": "npm run build && node --test tests/*.test.cjs",
    "prisma:test:auth": "node prisma/tests/auth-upgrade.test.mjs"
  },
  "dependencies": {
    "@nestjs/common": "12.5.0",
    "@nestjs/core": "12.5.0",
    "@nestjs/platform-express": "12.5.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "argon2": "^0.45.2",
    "cloudinary": "^2.11.0",
    "dotenv": "^17.2.3",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.5.0",
    "nodemailer": "^10.6.0",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@nestjs/cli": "11.0.24",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.15.6",
    "eslint": "9.39.5",
    "prisma": "7.10.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2"
  },
  "engines": {
    "node": ">=24.13.0 <25"
  }
}
